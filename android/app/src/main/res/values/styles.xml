<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#faf3e0</item>
        <item name="android:navigationBarColor">#faf3e0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <!-- 去除启动时 activity 切换动画（用户反馈"进软件有过场动画"） -->
        <item name="android:windowAnimationStyle">@style/Animation.AppTheme.NoAnimation</item>
    </style>

    <!-- 完全禁用 activity 启动 / 退出动画，避免与 WebView 之间的"过场"感 -->
    <style name="Animation.AppTheme.NoAnimation" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>

    <!--
        启动主题：状态栏 + 导航栏与 app 米黄色背景一致
        解决 Capacitor 启动时白条问题
        使用 android:windowSplashScreenBackground（API 31+ 官方推荐）
        并保留 android:windowBackground 以兼容旧版本
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ (API 31+) 官方推荐：splash screen background 颜色 -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#faf3e0</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- 兼容旧版本（API 26-30） -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">#faf3e0</item>
        <item name="android:navigationBarColor">#faf3e0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
