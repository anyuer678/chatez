{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatEZ",
  "version": "1.14.1",
  "identifier": "com.chatez.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatEZ · 书房手记",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ChatEZ",
    "shortDescription": "ChatEZ - 在书房里，与 AI 对话",
    "longDescription": "ChatEZ 是一款手绘复古风格的 AI 工作台，支持自定义角色（提示词）与 Skill 组合，让 AI 对话像翻一本属于你的手记。",
    "category": "Productivity",
    "copyright": "Copyright © 2026 ChatEZ",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
